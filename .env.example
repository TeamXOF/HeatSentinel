# ==========================================
# HeatSentinel AI — Environment Configuration
# ==========================================

# 1. Backend API Base URL (Used when USE_MOCK_DATA = false in src/api/config.ts)
# Defaults to http://localhost:8000 if not specified
VITE_API_BASE_URL="http://localhost:8000"

# 2. Google Gemini API Key (Optional / Future direct Gemini SDK calls)
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. Application URL (Optional, for OAuth / self-referential links)
APP_URL="http://localhost:3000"
